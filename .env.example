# PJSIP AI 语音对话系统 - 环境变量配置
# 复制此文件为 .env 并填入你的配置

# ==================== OpenAI 配置 ====================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==================== 阿里云 DashScope 配置 ====================
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# ==================== 阿里云 NLS 配置（可选）====================
# 如果使用阿里云 NLS 版本，需要配置以下项
ALIBABA_ACCESS_KEY=your-access-key
ALIBABA_ACCESS_SECRET=your-access-secret
ALIBABA_APPKEY=your-app-key

# ==================== SIP 服务器配置 ====================
SIP_SERVER=147.139.205.88
SIP_PORT=5060
SIP_CALLER_NUMBER=6281479242434
SIP_PREFIX=13462
SIP_TRANSPORT=
# SIP_SERVER=singa-prod.cherrycalls.com
# SIP_PORT=31100
# SIP_CALLER_NUMBER=10001
# SIP_PREFIX=

# ==================== SIP 认证配置 ====================
SIP_USERNAME=10001
SIP_PASSWORD=

# ==================== AI 配置 ====================
AI_MODEL=gpt-4o-mini
AI_LANGUAGE=id

# ==================== TTS 配置 ====================
TTS_PROVIDER=dashscope
# TTS_PROVIDER=openai
# openai: sage, alloy, echo, fable, onyx, nova, shimmer
# dashscope: sambert-indah-v1
# elevenlabs: 需要配置 ELEVENLABS_API_KEY
# TTS_VOICE=sage
TTS_VOICE=sambert-indah-v1

# ==================== 业务场景配置 ====================
# 场景类型: collection（催收）, ivr（确认）, general（通用）
SCENARIO=collection
CUSTOMER_NAME=Ahmad
CUSTOMER_GENDER=Bapak
COLLECT_AMOUNT=500000
TOTAL_COLLECT_AMOUNT=1000000
DUE_DATE=2026-02-10
DUE_SCENARIOS=D1

# ==================== ASR 配置 ====================
# ASR_PROVIDER: whisper（本地）或 dashscope（阿里云，印尼语更准）
ASR_PROVIDER=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ==================== API 服务端口 ====================
API_PORT=8090

# ==================== 通话时长上限 ====================
MAX_CALL_DURATION_SEC=120   # 2 分钟
PLAYBACK_GAIN=3.0
